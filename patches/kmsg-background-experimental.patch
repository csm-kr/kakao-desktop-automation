diff --git a/Sources/kmsg/KakaoTalk/BackgroundSendPolicy.swift b/Sources/kmsg/KakaoTalk/BackgroundSendPolicy.swift
new file mode 100644
index 0000000..5fd8b68
--- /dev/null
+++ b/Sources/kmsg/KakaoTalk/BackgroundSendPolicy.swift
@@ -0,0 +1,240 @@
+import Foundation
+
+// No launch, focus, raise, selection, keyboard, or mouse operations are available
+// through this interface. The check path only uses snapshot().
+protocol BackgroundSendDriver {
+    associatedtype Control
+    func snapshot(exactTitle: String) throws -> BackgroundSendSnapshot<Control>
+    func selectedText(_ text: String, on control: Control) throws
+    func text(on control: Control) throws -> String
+    func press(_ control: Control) throws
+}
+
+enum BackgroundEnabledValue: String, Encodable { case enabled, disabled, unreported }
+
+struct BackgroundEnabledObservation: Encodable, Equatable {
+    let state: BackgroundEnabledValue
+    let axError: Int?
+    let detail: String?
+
+    static func reported(_ value: Bool) -> Self {
+        Self(state: value ? .enabled : .disabled, axError: 0, detail: nil)
+    }
+
+    static func unreported(_ error: Int? = nil, detail: String? = nil) -> Self {
+        Self(state: .unreported, axError: error, detail: detail)
+    }
+}
+
+struct BackgroundSendSnapshot<Control> {
+    let verifiedTargetCount: Int
+    let scanComplete: Bool
+    let composers: [Control]
+    let buttons: [Control]
+    let composerDescriptionVerified: Bool
+    let composerEnabled: BackgroundEnabledObservation
+    let draft: String?
+    let selectedTextSettable: Bool
+    let buttonEnabled: BackgroundEnabledObservation
+    let buttonSupportsPress: Bool
+    var windowLookup: BackgroundWindowLookup? = nil
+}
+
+struct BackgroundWindowLookup: Encodable {
+    let lookupMode: String
+    let initialUniqueCount: Int?
+    let currentEnumerationCount: Int?
+    let currentExactTitleCount: Int?
+    let enumerationAXError: Int
+    let boundPID: Int?
+    var windowPIDAXError: Int? = nil
+    var windowRoleAXError: Int? = nil
+    var windowTitleAXError: Int? = nil
+    var identityValidated: Bool = false
+}
+
+struct BackgroundWindowIdentity {
+    let runningPID: Int?
+    let windowPID: Int?
+    let role: String?
+    let title: String?
+    let pidError: Int
+    let roleError: Int
+    let titleError: Int
+
+    func failure(expectedPID: Int, exactTitle: String) -> String? {
+        guard runningPID == expectedPID else { return "BOUND_APPLICATION_PID_CHANGED" }
+        guard pidError == 0, windowPID == expectedPID else { return "BOUND_WINDOW_PID_INVALID" }
+        guard roleError == 0, role == "AXWindow" else { return "BOUND_WINDOW_ROLE_INVALID" }
+        guard titleError == 0, title == exactTitle else { return "BOUND_WINDOW_TITLE_INVALID" }
+        return nil
+    }
+}
+
+struct BackgroundSendFailure: Error, CustomStringConvertible {
+    let description: String
+    var draftMayHaveChanged = false
+    var commitAttempts = 0
+    var composerEnabled: BackgroundEnabledObservation? = nil
+    var buttonEnabled: BackgroundEnabledObservation? = nil
+    var windowLookup: BackgroundWindowLookup? = nil
+}
+
+struct BackgroundSendReport: Encodable {
+    let mode = "background-safe"
+    let status: String
+    let reason: String?
+    let draftMayHaveChanged: Bool
+    let commitAttempts: Int
+    let messageSentVerified = false
+    var composerEnabled: BackgroundEnabledObservation? = nil
+    var buttonEnabled: BackgroundEnabledObservation? = nil
+    var windowLookup: BackgroundWindowLookup? = nil
+}
+
+enum BackgroundSendPolicy {
+    static func run<D: BackgroundSendDriver>(
+        driver: D, exactTitle: String, message: String?, checkOnly: Bool,
+        buttonReadyTimeout: TimeInterval = 2,
+        pollInterval: TimeInterval = 0.05,
+        clock: () -> TimeInterval = { ProcessInfo.processInfo.systemUptime },
+        wait: (TimeInterval) -> Void = { Thread.sleep(forTimeInterval: $0) }
+    ) throws -> BackgroundSendReport {
+        let state = try driver.snapshot(exactTitle: exactTitle)
+        func failure(_ reason: String) -> BackgroundSendFailure {
+            BackgroundSendFailure(description: reason, composerEnabled: state.composerEnabled,
+                                  buttonEnabled: state.buttonEnabled, windowLookup: state.windowLookup)
+        }
+        guard state.verifiedTargetCount == 1 else {
+            throw failure("EXACT_OPEN_WINDOW_NOT_UNIQUE")
+        }
+        guard state.scanComplete else {
+            throw failure("SCOPED_SCAN_INCOMPLETE")
+        }
+        guard state.composers.count == 1, state.composerDescriptionVerified else {
+            throw failure("VERIFIED_COMPOSER_NOT_UNIQUE")
+        }
+        if state.composerEnabled.state == .disabled {
+            throw failure("COMPOSER_EXPLICITLY_DISABLED")
+        }
+        guard state.draft == "" else {
+            throw failure("EXISTING_OR_UNREADABLE_DRAFT")
+        }
+        guard state.selectedTextSettable else {
+            throw failure("AX_SELECTED_TEXT_NOT_SETTABLE")
+        }
+        guard state.buttons.count == 1, state.buttonSupportsPress else {
+            throw failure("SCOPED_SEND_AXPRESS_NOT_UNIQUE")
+        }
+        if checkOnly {
+            let needsReadback = state.composerEnabled.state == .unreported
+            let needsButtonCheck = state.buttonEnabled.state != .enabled
+            return BackgroundSendReport(status: needsReadback ? "requires_input_readback_validation"
+                : (needsButtonCheck ? "requires_post_input_button_check" : "ready_for_controlled_test"),
+                reason: needsReadback ? "Composer AXEnabled is unreported; exact composer, empty readable draft and settable AXSelectedText are present, but writing was not tested"
+                    : (needsButtonCheck ? "Send button is not explicitly enabled with an empty draft; no input was performed" : nil),
+                draftMayHaveChanged: false, commitAttempts: 0,
+                composerEnabled: state.composerEnabled, buttonEnabled: state.buttonEnabled,
+                windowLookup: state.windowLookup)
+        }
+        guard let message, !message.isEmpty else {
+            throw failure("MESSAGE_REQUIRED")
+        }
+        let composer = state.composers[0]
+        var button = state.buttons[0]
+        var composerEnabled = state.composerEnabled
+        var buttonEnabled = state.buttonEnabled
+        var windowLookup = state.windowLookup
+        // Read again immediately before mutation. Never erase an existing draft.
+        guard try driver.text(on: composer) == "" else {
+            throw failure("DRAFT_CHANGED_BEFORE_INSERT")
+        }
+        do {
+            try driver.selectedText(message, on: composer)
+            guard try driver.text(on: composer) == message else {
+                throw BackgroundSendFailure(description: "INSERT_NOT_REFLECTED")
+            }
+            // AXEnabled is legitimately absent on some native text areas.
+            // Unreported is NOT true: exact readback of our one selected-text
+            // write is the additional write-capability evidence required here.
+            let deadline = clock() + buttonReadyTimeout
+            while true {
+                let current = try driver.snapshot(exactTitle: exactTitle)
+                composerEnabled = current.composerEnabled
+                buttonEnabled = current.buttonEnabled
+                windowLookup = current.windowLookup
+                // Only a known-disabled send button may be awaited. Target,
+                // draft or structural changes are terminal, not retry hints.
+                guard current.verifiedTargetCount == 1, current.scanComplete,
+                      current.composers.count == 1, current.composerDescriptionVerified,
+                      current.selectedTextSettable,
+                      current.composerEnabled.state != .disabled,
+                      current.draft == message,
+                      current.buttons.count == 1, current.buttonSupportsPress else {
+                    throw BackgroundSendFailure(description: "CONTROL_NOT_VERIFIED_BEFORE_COMMIT")
+                }
+                if current.buttonEnabled.state == .enabled {
+                    button = current.buttons[0]
+                    break
+                }
+                guard current.buttonEnabled.state == .disabled else {
+                    throw BackgroundSendFailure(description: "SEND_BUTTON_ENABLED_UNREPORTED")
+                }
+                let remaining = deadline - clock()
+                guard remaining > 0 else {
+                    throw BackgroundSendFailure(description: "SEND_BUTTON_ENABLE_TIMEOUT")
+                }
+                wait(min(pollInterval, remaining))
+            }
+        } catch {
+            throw BackgroundSendFailure(description: "PRECOMMIT_STOP: \(error)",
+                draftMayHaveChanged: true, composerEnabled: composerEnabled, buttonEnabled: buttonEnabled,
+                windowLookup: (error as? BackgroundSendFailure)?.windowLookup ?? windowLookup)
+        }
+        // Exactly one commit attempt. Even an AX error may follow a delivered
+        // action, so callers must not retry this uncertain result automatically.
+        do {
+            try driver.press(button)
+        } catch {
+            throw BackgroundSendFailure(description: "COMMIT_UNCONFIRMED: \(error)",
+                draftMayHaveChanged: true, commitAttempts: 1,
+                composerEnabled: composerEnabled, buttonEnabled: buttonEnabled, windowLookup: windowLookup)
+        }
+        return BackgroundSendReport(status: "commit_attempted_unconfirmed",
+                                    reason: "Independent outgoing-message verification is required; do not retry",
+            draftMayHaveChanged: true, commitAttempts: 1,
+            composerEnabled: composerEnabled, buttonEnabled: buttonEnabled, windowLookup: windowLookup)
+    }
+}
+
+// One process, one fixed target/message, one nonce-qualified commit signal.
+// Preparing calls the read-only path; no mutation is possible before commit().
+final class BackgroundSendSession<D: BackgroundSendDriver> {
+    private let driver: D
+    private let exactTitle: String
+    private let message: String
+    let nonce: String
+    private var prepared = false
+    private var consumed = false
+
+    init(driver: D, exactTitle: String, message: String, nonce: String = UUID().uuidString) {
+        self.driver = driver
+        self.exactTitle = exactTitle
+        self.message = message
+        self.nonce = nonce
+    }
+
+    func prepare() throws -> BackgroundSendReport {
+        guard !prepared, !consumed else { throw BackgroundSendFailure(description: "SESSION_ALREADY_PREPARED") }
+        let result = try BackgroundSendPolicy.run(driver: driver, exactTitle: exactTitle, message: nil, checkOnly: true)
+        prepared = true
+        return result
+    }
+
+    func commit(signal: String) throws -> BackgroundSendReport {
+        guard prepared, !consumed else { throw BackgroundSendFailure(description: "COMMIT_SIGNAL_ALREADY_CONSUMED_OR_NOT_PREPARED") }
+        consumed = true
+        guard signal == "COMMIT \(nonce)" else { throw BackgroundSendFailure(description: "INVALID_COMMIT_SIGNAL") }
+        return try BackgroundSendPolicy.run(driver: driver, exactTitle: exactTitle, message: message, checkOnly: false)
+    }
+}
