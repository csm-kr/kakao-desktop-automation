new file mode 100644
index 0000000..bf81111
--- /dev/null
+++ b/Sources/kmsg/KakaoTalk/BackgroundSendAXDriver.swift
@@ -0,0 +1,148 @@
+import ApplicationServices.HIServices
+import Foundation
+
+final class BackgroundSendAXDriver: BackgroundSendDriver {
+    typealias Control = UIElement
+    private let kakao: KakaoTalkApp
+    private let expectedPID: Int
+    private let retainVerifiedWindow: Bool
+    private var retainedWindow: UIElement?
+    private var retainedTitle: String?
+    private var initialUniqueCount: Int?
+
+    init(retainVerifiedWindow: Bool = false) throws {
+        kakao = try KakaoTalkApp(autoLaunch: false)
+        guard let running = KakaoTalkApp.runningApplication else { throw KakaoTalkError.appNotRunning }
+        expectedPID = Int(running.processIdentifier)
+        self.retainVerifiedWindow = retainVerifiedWindow
+    }
+
+    func snapshot(exactTitle: String) throws -> BackgroundSendSnapshot<UIElement> {
+        // Enumerate for evidence, but never turn AXWindows=[] into a fabricated
+        // unique current result when a previously bound opaque handle is used.
+        var rawWindows: CFTypeRef?
+        let enumerationError = AXUIElementCopyAttributeValue(kakao.applicationElement.axElement,
+                                                            kAXWindowsAttribute as CFString, &rawWindows)
+        let enumerated = enumerationError == .success ? rawWindows as? [AXUIElement] : nil
+        let windows = enumerated?.map(UIElement.init).filter { $0.title == exactTitle }
+        var lookup = BackgroundWindowLookup(
+            lookupMode: retainedWindow == nil ? "current_exact_enumeration" : "retained_verified_window",
+            initialUniqueCount: initialUniqueCount ?? windows?.count,
+            currentEnumerationCount: enumerated?.count, currentExactTitleCount: windows?.count,
+            enumerationAXError: Int(enumerationError.rawValue), boundPID: retainedWindow == nil ? nil : expectedPID)
+        let window: UIElement
+        if let retainedWindow {
+            guard retainedTitle == exactTitle else {
+                throw BackgroundSendFailure(description: "BOUND_REQUEST_TITLE_CHANGED", windowLookup: lookup)
+            }
+            guard (windows?.count ?? 0) <= 1 else {
+                throw BackgroundSendFailure(description: "CURRENT_EXACT_WINDOWS_AMBIGUOUS", windowLookup: lookup)
+            }
+            window = retainedWindow
+        } else if let windows, windows.count == 1 {
+            window = windows[0]
+        } else {
+            return BackgroundSendSnapshot(verifiedTargetCount: windows?.count ?? 0, scanComplete: true,
+                composers: [], buttons: [], composerDescriptionVerified: false,
+                composerEnabled: .unreported(detail: "composer_not_resolved"), draft: nil, selectedTextSettable: false,
+                buttonEnabled: .unreported(detail: "button_not_resolved"), buttonSupportsPress: false,
+                windowLookup: lookup)
+        }
+        var pid: pid_t = 0
+        let pidError = AXUIElementGetPid(window.axElement, &pid)
+        func rawString(_ name: String) -> (Int, String?) {
+            var value: CFTypeRef?
+            let error = AXUIElementCopyAttributeValue(window.axElement, name as CFString, &value)
+            return (Int(error.rawValue), value as? String)
+        }
+        let (roleError, role) = rawString(kAXRoleAttribute)
+        let (titleError, title) = rawString(kAXTitleAttribute)
+        lookup.windowPIDAXError = Int(pidError.rawValue)
+        lookup.windowRoleAXError = roleError
+        lookup.windowTitleAXError = titleError
+        let identity = BackgroundWindowIdentity(
+            runningPID: KakaoTalkApp.runningApplication.map { Int($0.processIdentifier) },
+            windowPID: pidError == .success ? Int(pid) : nil, role: role, title: title,
+            pidError: Int(pidError.rawValue), roleError: roleError, titleError: titleError)
+        if let failure = identity.failure(expectedPID: expectedPID, exactTitle: exactTitle) {
+            throw BackgroundSendFailure(description: failure, windowLookup: lookup)
+        }
+        lookup.identityValidated = true
+        if retainVerifiedWindow && retainedWindow == nil {
+            retainedWindow = window
+            retainedTitle = exactTitle
+            initialUniqueCount = 1
+            lookup = BackgroundWindowLookup(lookupMode: "retained_verified_window", initialUniqueCount: 1,
+                currentEnumerationCount: enumerated?.count, currentExactTitleCount: windows?.count,
+                enumerationAXError: Int(enumerationError.rawValue), boundPID: expectedPID,
+                windowPIDAXError: Int(pidError.rawValue), windowRoleAXError: roleError,
+                windowTitleAXError: titleError, identityValidated: true)
+        }
+        var queue = [(window, 0)]
+        var index = 0
+        var complete = true
+        var composers: [UIElement] = []
+        var buttons: [UIElement] = []
+        while index < queue.count && index < 600 {
+            let (node, depth) = queue[index]
+            index += 1
+            let role = node.role ?? ""
+            if role == kAXTextAreaRole, node.axDescription == "메시지 입력" {
+                composers.append(node)
+            }
+            if role == kAXButtonRole {
+                let names = [node.title, node.axDescription].compactMap { $0 }
+                if names.contains(where: { $0 == "전송" || $0 == "Send" }) {
+                    buttons.append(node)
+                }
+            }
+            // Message transcript tables cannot be the composer/send toolbar.
+            // Do not traverse thousands of conversation rows or their buttons.
+            if role == kAXTableRole || role == kAXRowRole { continue }
+            let children = node.children
+            if depth >= 18 {
+                if !children.isEmpty { complete = false }
+                continue
+            }
+            queue.append(contentsOf: children.map { ($0, depth + 1) })
+        }
+        if index < queue.count { complete = false }
+        let composer = composers.count == 1 ? composers[0] : nil
+        let button = buttons.count == 1 ? buttons[0] : nil
+        var settable: DarwinBoolean = false
+        let settableResult = composer.map {
+            AXUIElementIsAttributeSettable($0.axElement, kAXSelectedTextAttribute as CFString, &settable)
+        }
+        return BackgroundSendSnapshot(verifiedTargetCount: 1, scanComplete: complete,
+            composers: composers, buttons: buttons, composerDescriptionVerified: composer != nil,
+            composerEnabled: composer.map(enabledObservation) ?? .unreported(detail: "composer_not_unique"), draft: composer?.stringValue,
+            selectedTextSettable: settableResult == .success && settable.boolValue,
+            buttonEnabled: button.map(enabledObservation) ?? .unreported(detail: "button_not_unique"),
+            buttonSupportsPress: (try? button?.actionNames().contains(kAXPressAction)) ?? false,
+            windowLookup: lookup)
+    }
+
+    func selectedText(_ text: String, on control: UIElement) throws {
+        try control.setAttribute(kAXSelectedTextAttribute, value: text as CFString)
+    }
+
+    func text(on control: UIElement) throws -> String {
+        try control.attribute(kAXValueAttribute)
+    }
+
+    private func enabledObservation(_ control: UIElement) -> BackgroundEnabledObservation {
+        var value: CFTypeRef?
+        let error = AXUIElementCopyAttributeValue(control.axElement, kAXEnabledAttribute as CFString, &value)
+        guard error == .success else {
+            return .unreported(Int(error.rawValue), detail: error == .attributeUnsupported ? "attributeUnsupported" : "AXEnabled_read_failed")
+        }
+        guard let value, CFGetTypeID(value) == CFBooleanGetTypeID(), let flag = value as? Bool else {
+            return .unreported(Int(error.rawValue), detail: "AXEnabled_not_boolean")
+        }
+        return .reported(flag)
+    }
+
+    func press(_ control: UIElement) throws {
+        try control.performAction(kAXPressAction)
+    }
+}
