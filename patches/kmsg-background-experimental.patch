+import Darwin
+import Foundation
+
+struct BackgroundPreparedReceipt: Encodable {
+    let phase = "prepared"
+    let nonce: String
+    let commitSignal: String
+    let timeoutSeconds: Double
+    let readiness: BackgroundSendReport
+}
+
+enum BackgroundCommitSignal {
+    // Read only the caller's stdin. Polling keeps the deadline finite and lets
+    // the current run loop service native callbacks without doing any UI action.
+    static func wait(timeout: Double) throws -> String {
+        let deadline = ProcessInfo.processInfo.systemUptime + timeout
+        var collected = Data()
+        while ProcessInfo.processInfo.systemUptime < deadline {
+            _ = RunLoop.current.run(mode: .default, before: Date().addingTimeInterval(0.01))
+            var descriptor = pollfd(fd: STDIN_FILENO, events: Int16(POLLIN), revents: 0)
+            let result = poll(&descriptor, 1, 50)
+            if result < 0 {
+                if errno == EINTR { continue }
+                throw BackgroundSendFailure(description: "COMMIT_SIGNAL_POLL_FAILED")
+            }
+            guard result > 0 else { continue }
+            guard ProcessInfo.processInfo.systemUptime < deadline else {
+                throw BackgroundSendFailure(description: "COMMIT_SIGNAL_TIMEOUT")
+            }
+            var bytes = [UInt8](repeating: 0, count: 256)
+            let count = read(STDIN_FILENO, &bytes, bytes.count)
+            guard count > 0 else { throw BackgroundSendFailure(description: "COMMIT_INPUT_CLOSED") }
+            collected.append(contentsOf: bytes.prefix(count))
+            guard collected.count <= 256 else { throw BackgroundSendFailure(description: "COMMIT_SIGNAL_TOO_LONG") }
+            if let newline = collected.firstIndex(of: 10) {
+                var line = collected.prefix(upTo: newline)
+                if line.last == 13 { line = line.dropLast() }
+                guard let decoded = String(data: line, encoding: .utf8) else {
+                    throw BackgroundSendFailure(description: "COMMIT_SIGNAL_NOT_UTF8")
+                }
+                return decoded
+            }
+        }
+        throw BackgroundSendFailure(description: "COMMIT_SIGNAL_TIMEOUT")
+    }
+}
